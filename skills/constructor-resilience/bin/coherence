#!/usr/bin/env bash
# Thin trampoline. Canonical wrapper + functions live in constructor-resilience.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
CANON="$(cd "$HERE/../../../.." && pwd)/constructor-resilience/skills/constructor-resilience/bin/coherence"
if [[ -x "$CANON" ]]; then
  exec "$CANON" "$@"
fi
PREFIX="${CONSTRUCTOR_RESILIENCE_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/constructor-resilience/venv}"
BIN="$PREFIX/bin/coherence"
if [[ ! -x "$BIN" ]]; then
  echo "coherence CLI missing; pip-install constructor-resilience or clone it next to this skill" >&2
  exit 127
fi
exec "$BIN" "$@"
